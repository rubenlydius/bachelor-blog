---
import Logo from '../assets/logo.svg';
import { SITE_TITLE } from '../consts';
import { url } from '../lib/url';

const links = [
	{ href: url('/'), label: 'Home' },
	{ href: url('/posts/'), label: 'Posts' },
	{ href: url('/team/'), label: 'Team' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === url('/') ? path === href : path.startsWith(href));
---

<header class="container">
	<a class="logo" href={url('/')} aria-label={`${SITE_TITLE}, home`}>
		<Logo aria-hidden="true" />
	</a>
	<nav>
		{links.map(({ href, label }) => (
			<a href={href} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? 'page' : undefined}>
				{label}
			</a>
		))}
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		padding-block: 1.25rem;
	}
	.logo {
		display: flex;
		color: var(--color-accent);
	}
	.logo :global(svg) {
		width: auto;
		height: 2.25rem;
	}
	nav {
		display: flex;
		gap: 0.5rem;
	}
	nav a {
		padding: 0.15em 0.85em;
		border: 1px solid transparent;
		border-radius: 999px;
		color: var(--color-text);
		font-size: 0.9375rem;
		text-decoration: none;
	}
	nav a:hover {
		border-color: var(--color-border);
	}
	nav a.active {
		border-color: var(--color-text);
	}
</style>
