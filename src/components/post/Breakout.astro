---
interface Props {
	/** accent: colored box · plain: large text without box */
	variant?: 'accent' | 'plain';
	/** wide: breaks out of the text column */
	wide?: boolean;
}

const { variant = 'accent', wide = false } = Astro.props;
---

<aside class:list={['breakout', variant, { wide }]}>
	<slot />
</aside>

<style>
	.breakout {
		clear: both;
		margin: 3.5rem 0;
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}
	.accent {
		padding: 2rem 2.25rem;
		background: var(--color-text);
		border-radius: var(--radius-leaf);
		color: var(--color-accent);
	}
	.plain {
		padding-left: 1.5rem;
		border-left: 1px solid var(--color-accent);
	}
	.breakout :global(p) {
		margin: 0;
	}
</style>
