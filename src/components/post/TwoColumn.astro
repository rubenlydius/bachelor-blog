---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { url } from '../../lib/url';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
	/** Image on the right instead of the left */
	reverse?: boolean;
	wide?: boolean;
	/** Image takes a third of the width instead of half, e.g. for tall screenshots */
	narrow?: boolean;
}

const { src, alt, caption, reverse = false, wide = false, narrow = false } = Astro.props;
---

<section class:list={['two-column', { reverse, wide, narrow }]}>
	<figure>
		{typeof src === 'string' ? (
			<img src={src.startsWith('/') ? url(src) : src} alt={alt} loading="lazy" />
		) : (
			<Image src={src} alt={alt} width={900} format="avif" />
		)}
		{caption && <figcaption class="mono">{caption}</figcaption>}
	</figure>
	<div class="text">
		<slot />
	</div>
</section>

<style>
	.two-column {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
		clear: both;
		margin: 3rem 0;
	}
	.reverse figure {
		order: 2;
	}
	.narrow {
		grid-template-columns: 1fr 2fr;
	}
	.narrow.reverse {
		grid-template-columns: 2fr 1fr;
	}
	figure {
		margin: 0;
	}
	img {
		width: 100%;
		border-radius: var(--radius);
	}
	/* Same caption style as Figure: a short hairline before the text */
	figcaption {
		display: flex;
		gap: 0.6rem;
		margin-top: 0.6rem;
		line-height: 1.4;
	}
	figcaption::before {
		content: '';
		flex: none;
		width: 1.25rem;
		height: 1px;
		margin-top: 0.65em;
		background: var(--color-line);
	}
	.text :global(> :last-child) {
		margin-bottom: 0;
	}
	@media (max-width: 640px) {
		.two-column,
		.narrow.reverse {
			grid-template-columns: 1fr;
		}
		.reverse figure {
			order: 0;
		}
	}
</style>
