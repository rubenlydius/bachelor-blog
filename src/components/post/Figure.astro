---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** Imported image (optimized) or a path in /public */
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
	/** center: in the text column · left/right: floats, text wraps around · wide/full: breaks out of the column */
	align?: 'center' | 'left' | 'right' | 'wide' | 'full';
}

const { src, alt, caption, align = 'center' } = Astro.props;
const widths = { center: 900, left: 600, right: 600, wide: 1400, full: 2400 };
---

<figure class:list={['figure', align]}>
	{typeof src === 'string' ? (
		<img src={src} alt={alt} loading="lazy" />
	) : (
		<Image src={src} alt={alt} width={widths[align]} />
	)}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 2.5rem 0;
	}
	img {
		width: 100%;
		border-radius: var(--radius);
	}
	.full img {
		border-radius: 0;
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--color-muted);
		font-size: 0.875rem;
	}
	.full figcaption {
		padding-inline: var(--gutter);
	}
	.left,
	.right {
		width: 50%;
		margin-top: 0.35rem;
		margin-bottom: 1rem;
	}
	.left {
		float: left;
		margin-right: 1.75rem;
	}
	.right {
		float: right;
		margin-left: 1.75rem;
	}
	@media (max-width: 640px) {
		.left,
		.right {
			float: none;
			width: 100%;
			margin: 2rem 0;
		}
	}
</style>
