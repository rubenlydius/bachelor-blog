---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** Imported image (optimized) or a path in /public */
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
	/** center: in the text column · left/right: floats, text wraps around · wide/full: breaks out of the column */
	align?: 'center' | 'left' | 'right' | 'wide' | 'full';
}

const { src, alt, caption, align = 'center' } = Astro.props;
const widths = { center: 900, left: 600, right: 600, wide: 1400, full: 2400 };
---

<figure class:list={['figure', align]}>
	{typeof src === 'string' ? (
		<img src={src} alt={alt} loading="lazy" />
	) : (
		<Image src={src} alt={alt} width={widths[align]} />
	)}
	{caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 2.5rem 0;
	}
	img {
		width: 100%;
		border-radius: var(--radius);
	}
	.full img {
		border-radius: 0;
	}
	figcaption {
		display: flex;
		gap: 0.6rem;
		margin-top: 0.6rem;
		line-height: 1.4;
	}
	/* Short hairline before the caption, like an annotation leader */
	figcaption::before {
		content: '';
		flex: none;
		width: 1.25rem;
		height: 1px;
		margin-top: 0.65em;
		background: var(--color-line);
	}
	.full figcaption {
		padding-inline: var(--gutter);
	}
	.left,
	.right {
		width: 50%;
		margin-top: 0.35rem;
		margin-bottom: 1rem;
	}
	.left {
		float: left;
		margin-right: 1.75rem;
	}
	.right {
		float: right;
		margin-left: 1.75rem;
	}
	@media (max-width: 640px) {
		.left,
		.right {
			float: none;
			width: 100%;
			margin: 2rem 0;
		}
	}
</style>
