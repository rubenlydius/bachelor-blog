---
interface Props {
	/** Number of equal columns. Without it, images share one row at the same height */
	columns?: number;
	wide?: boolean;
	/** One caption under the whole row, instead of under a single image */
	caption?: string;
}

const { columns, wide = false, caption } = Astro.props;
const style = columns ? `--columns: ${columns}` : undefined;
---

{caption ? (
	<figure class:list={['image-row-group', { wide }]}>
		<div class:list={['image-row', { grid: columns }]} style={style}>
			<slot />
		</div>
		<figcaption class="mono">{caption}</figcaption>
	</figure>
) : (
	<div class:list={['image-row', { wide, grid: columns }]} style={style}>
		<slot />
	</div>
)}

<style>
	.image-row {
		display: flex;
		gap: 1rem;
		clear: both;
		margin: 2.5rem 0;
	}
	/* Each item grows by its aspect ratio, so all images end up the same height */
	.image-row > :global(*) {
		flex: var(--ratio, 1) 1 0;
		min-width: 0;
	}
	/* Rows right after each other sit as close as the images within a row */
	.image-row:has(+ .image-row) {
		margin-bottom: 1rem;
	}
	.image-row + .image-row {
		margin-top: 1rem;
	}
	/* With a caption: the figure takes the outer spacing, the row inside has none */
	.image-row-group {
		clear: both;
		margin: 2.5rem 0;
	}
	.image-row-group > .image-row {
		margin: 0;
	}
	/* Same caption style as Figure: a short hairline before the text */
	figcaption {
		display: flex;
		gap: 0.6rem;
		margin-top: 0.6rem;
		line-height: 1.4;
	}
	figcaption::before {
		content: '';
		flex: none;
		width: 1.25rem;
		height: 1px;
		margin-top: 0.65em;
		background: var(--color-line);
	}
	.image-row.grid {
		display: grid;
		grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
	}
	/* Figures inside a row ignore their own align/spacing */
	.image-row > :global(.figure) {
		float: none;
		width: auto;
		margin: 0;
	}
	@media (max-width: 640px) {
		.image-row {
			flex-direction: column;
		}
		/* With a caption: the figure takes the outer spacing, the row inside has none */
	.image-row-group {
		clear: both;
		margin: 2.5rem 0;
	}
	.image-row-group > .image-row {
		margin: 0;
	}
	/* Same caption style as Figure: a short hairline before the text */
	figcaption {
		display: flex;
		gap: 0.6rem;
		margin-top: 0.6rem;
		line-height: 1.4;
	}
	figcaption::before {
		content: '';
		flex: none;
		width: 1.25rem;
		height: 1px;
		margin-top: 0.65em;
		background: var(--color-line);
	}
	.image-row.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
