---
interface Props {
	/** Number of columns (defaults to the number of images, auto-wraps on small screens) */
	columns?: number;
	wide?: boolean;
}

const { columns, wide = false } = Astro.props;
---

<div class:list={['image-row', { wide }]} style={columns ? `--columns: ${columns}` : undefined}>
	<slot />
</div>

<style>
	.image-row {
		display: grid;
		grid-template-columns: repeat(var(--columns, auto-fit), minmax(0, 1fr));
		gap: 1rem;
		clear: both;
		margin: 2.5rem 0;
	}
	/* Figures inside a row ignore their own align/spacing */
	.image-row > :global(.figure) {
		float: none;
		width: auto;
		margin: 0;
	}
	@media (max-width: 640px) {
		.image-row {
			grid-template-columns: 1fr;
		}
	}
</style>
