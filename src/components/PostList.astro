---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getMember } from '../data/team';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{posts.map((post) => (
		<li data-tags={post.data.tags.join('|')}>
			<a href={`/posts/${post.id}/`}>
				{post.data.cover ? (
					<Image src={post.data.cover} alt={post.data.coverAlt} width={720} />
				) : (
					<div class="no-cover" />
				)}
				<h3>{post.data.title}</h3>
				<p class="description">{post.data.description}</p>
				<p class="meta mono">
					<FormattedDate date={post.data.date} />
					{post.data.author && <span>{getMember(post.data.author).name}</span>}
					{post.data.draft && <span class="pill">draft</span>}
				</p>
			</a>
		</li>
	))}
</ul>

<style>
	.post-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 3.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	img,
	.no-cover {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		margin-bottom: 1.25rem;
		border-radius: var(--radius-leaf);
		transition: border-radius 0.4s ease;
	}
	.no-cover {
		background: var(--color-accent-bg);
	}
	a:hover img,
	a:hover .no-cover {
		border-radius: var(--radius);
	}
	h3 {
		margin: 0 0 0.35em;
		font-size: 1.375rem;
	}
	a:hover h3 {
		color: var(--color-accent);
	}
	.description {
		margin: 0 0 0.75rem;
		color: var(--color-muted);
		line-height: 1.45;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
		margin: 0;
		white-space: nowrap;
	}
	.pill {
		color: var(--color-text);
	}
</style>
