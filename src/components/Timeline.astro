---
import type { TimelineEvent } from '../data/timeline';

interface Props {
	events: TimelineEvent[];
}

const { events } = Astro.props;

const time = (date: string) => new Date(`${date}T00:00:00`).getTime();
const start = time(events[0].date);
const end = time(events[events.length - 1].date);
const position = (date: string) => ((time(date) - start) / (end - start)) * 100;
const format = (date: string) =>
	new Date(`${date}T00:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<div class="timeline" data-start={start} data-end={end}>
	<div class="track">
		<div class="fill"></div>
		<div class="today"><span>Today</span></div>
	</div>
	<ol>
		{events.map((event, i) => (
			<li
				class:list={['event', i % 2 ? 'above' : 'below']}
				style={`--pos: ${position(event.date)}%`}
				data-time={time(event.date)}
			>
				<span class="dot"></span>
				<span class="label">
					<time datetime={event.date}>{format(event.date)}</time>
					<strong>{event.label}</strong>
				</span>
			</li>
		))}
	</ol>
</div>

<script>
	// Runs in the browser so progress follows the visitor's current date, not the build date.
	function update() {
		const now = Date.now();
		for (const el of document.querySelectorAll<HTMLElement>('.timeline')) {
			const start = Number(el.dataset.start);
			const end = Number(el.dataset.end);
			const progress = Math.min(Math.max((now - start) / (end - start), 0), 1);
			el.style.setProperty('--progress', `${progress * 100}%`);
			el.classList.toggle('in-range', now >= start && now <= end);
			for (const event of el.querySelectorAll<HTMLElement>('.event')) {
				event.classList.toggle('done', now >= Number(event.dataset.time));
			}
		}
	}
	update();
</script>

<style>
	.timeline {
		--progress: 0%;
		--dot: 1rem;
		position: relative;
		/* room for labels above and below the bar */
		padding-block: 4rem;
		margin-inline: calc(var(--dot) / 2);
	}
	.track {
		position: relative;
		height: 4px;
		background: var(--color-border);
		border-radius: 999px;
	}
	.fill {
		width: var(--progress);
		height: 100%;
		background: var(--color-accent);
		border-radius: inherit;
	}
	.today {
		display: none;
		position: absolute;
		left: var(--progress);
		top: 50%;
		width: 2px;
		height: 1.75rem;
		background: var(--color-accent);
		transform: translate(-50%, -50%);
	}
	.in-range .today {
		display: block;
	}
	.today span {
		position: absolute;
		bottom: 100%;
		left: 50%;
		transform: translateX(-50%);
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		white-space: nowrap;
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.event {
		position: absolute;
		top: 50%;
		left: var(--pos);
	}
	.dot {
		position: absolute;
		width: var(--dot);
		height: var(--dot);
		background: var(--color-bg);
		border: 3px solid var(--color-border);
		border-radius: 50%;
		transform: translate(-50%, -50%);
	}
	.done .dot {
		background: var(--color-accent);
		border-color: var(--color-accent);
	}
	.label {
		position: absolute;
		display: flex;
		flex-direction: column;
		transform: translateX(-50%);
		line-height: 1.3;
		text-align: center;
		white-space: nowrap;
	}
	.below .label {
		top: 1.25rem;
	}
	.above .label {
		bottom: 1.25rem;
	}
	/* Keep the first and last labels inside the bar's edges */
	.event:first-child .label {
		transform: none;
		text-align: left;
		left: calc(var(--dot) / -2);
	}
	.event:last-child .label {
		transform: none;
		text-align: right;
		right: calc(var(--dot) / -2);
	}
	time {
		color: var(--color-muted);
		font-size: 0.8125rem;
	}
	.done strong {
		color: var(--color-accent);
	}
</style>
