---
import type { MemberId } from '../data/members';
import { formatHours, type Hours, totalHours } from '../data/pillars';
import { team } from '../data/team';
import HoursBar from './HoursBar.astro';

interface Props {
	time: Partial<Record<MemberId, Hours>>;
}

const { time } = Astro.props;
const rows = team.filter((member) => time[member.id]).map((member) => ({ member, hours: time[member.id]! }));
const max = Math.max(...rows.map((row) => totalHours(row.hours)), 1);
const teamTotal = rows.reduce((sum, row) => sum + totalHours(row.hours), 0);
---

<section class="time-report">
	<ul>
		{rows.map(({ member, hours }) => (
			<li>
				<div class="row-header">
					<a href={`/team/${member.id}/`}>{member.name}</a>
					<span class="total">{formatHours(totalHours(hours))}</span>
				</div>
				<HoursBar hours={hours} max={max} />
			</li>
		))}
	</ul>
	<p class="team-total mono">
		<span>Team total</span>
		<strong>{formatHours(teamTotal)}</strong>
	</p>
</section>

<style>
	.time-report {
		margin: 1rem 0 3rem;
	}
	ul {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.row-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.row-header a {
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
	}
	.row-header a:hover {
		text-decoration: underline;
	}
	.total {
		font-family: var(--font-display);
		font-size: 1.375rem;
		letter-spacing: var(--tracking-display);
	}
	.team-total {
		display: flex;
		justify-content: space-between;
		margin: 2rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-line);
		color: var(--color-text);
	}
</style>
