---
import { Image } from 'astro:assets';
import { type CollectionEntry, getEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TimeReport from '../components/TimeReport.astro';
import { SITE_TITLE } from '../consts';
import { readingOrder } from '../data/reading-order';
import { getMember } from '../data/team';
import { getPosts } from '../lib/posts';
import { url } from '../lib/url';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'posts'>['data'] & { id: string };

const { id, title, description, date, updated, author, cover, coverAlt, tags, time } = Astro.props;
const member = author && getMember(author);

// Neighbours in the reading order (src/data/reading-order.ts), skipping posts that
// aren't published (drafts in production).
const published = new Map((await getPosts()).map((post) => [post.id, post]));
for (const slug of readingOrder) {
	if (!(await getEntry('posts', slug))) throw new Error(`reading-order.ts lists a post that doesn't exist: ${slug}`);
}
const order = readingOrder.filter((slug) => published.has(slug));
const index = order.indexOf(id);
const prev = index > 0 ? published.get(order[index - 1]) : undefined;
const next = index >= 0 && index < order.length - 1 ? published.get(order[index + 1]) : undefined;
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description} image={cover}>
	<article>
		<header class="post-header post-body">
			<h1>{title}</h1>
			<p class="lead">{description}</p>
			<div class="meta mono">
				<span class="node"></span>
				<FormattedDate date={date} />
				{updated && (
					<span>
						updated <FormattedDate date={updated} />
					</span>
				)}
				{member && (
					<a class="author" href={url(`/team/${member.id}/`)}>
						{member.name}
					</a>
				)}
				{tags.map((tag) => <a class="pill" href={url(`/posts/?tag=${encodeURIComponent(tag)}`)}>{tag}</a>)}
			</div>
			{cover && <Image class="wide cover" src={cover} alt={coverAlt} width={1600} priority />}
		</header>

		<div class="post-body">
			{time && <TimeReport time={time} />}
			<slot />
		</div>

		{(prev || next) && (
			<nav class="post-body pager" aria-label="Previous and next article">
				<div class="pager-row">
					{prev && (
						<a class="pill" href={url(`/posts/${prev.id}/`)} rel="prev" title={prev.data.title}>
							<svg class="back" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" /></svg>
							Previous article
						</a>
					)}
					{next && (
						<a class="pill next" href={url(`/posts/${next.id}/`)} rel="next" title={next.data.title}>
							Next article
							<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" /></svg>
						</a>
					)}
				</div>
			</nav>
		)}
	</article>
</BaseLayout>

<style>
	.post-header {
		margin-block: 4rem 3rem;
	}
	.post-header h1 {
		margin-bottom: 1.5rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-line);
	}
	.author {
		color: var(--color-text);
		text-decoration: none;
	}
	.author:hover {
		text-decoration: underline;
	}
	.pager {
		display: grid;
		gap: 0.75rem;
		margin-top: 4rem;
	}
	.pager-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.pager .pill {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}
	.pager .next {
		margin-left: auto;
	}
	.pager svg {
		width: 0.85em;
		height: 0.85em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
	}
	.pager .back {
		transform: scaleX(-1);
	}
	.cover {
		margin-top: 3rem;
		border-radius: var(--radius-leaf);
	}
</style>
