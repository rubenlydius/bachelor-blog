---
import { Image } from 'astro:assets';
import { type CollectionEntry, getEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TimeReport from '../components/TimeReport.astro';
import { SITE_TITLE } from '../consts';
import { getMember } from '../data/team';
import { url } from '../lib/url';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'posts'>['data'];

const { title, description, date, updated, author, cover, coverAlt, tags, time, prev, next } = Astro.props;
const member = author && getMember(author);
type Links = CollectionEntry<'posts'>['data']['prev'];
type Neighbour = { tag?: string; post: CollectionEntry<'posts'> };

// Resolves `prev`/`next` to posts, each with the tag (storyline) it belongs to.
// A single slug uses the first tag both posts share; a map names the tag itself.
async function resolve(links: Links): Promise<Neighbour[]> {
	if (!links) return [];
	const pairs = typeof links === 'string' ? [[undefined, links] as const] : Object.entries(links);
	const found = await Promise.all(
		pairs.map(async ([tag, slug]) => {
			const post = await getEntry('posts', slug);
			if (!post) throw new Error(`"${title}" links to a post that doesn't exist: ${slug}`);
			return { tag: tag ?? tags.find((t) => post.data.tags.includes(t)), post };
		}),
	);
	return found;
}

const prevLinks = await resolve(prev);
const nextLinks = await resolve(next);
// One row per storyline, in the order of this post's tags; links without a tag go last
const rowTags = [...new Set([...prevLinks, ...nextLinks].map((link) => link.tag))].sort(
	(a, b) => (a ? tags.indexOf(a) : Infinity) - (b ? tags.indexOf(b) : Infinity),
);
const rows = rowTags.map((tag) => ({
	tag,
	prev: prevLinks.find((link) => link.tag === tag)?.post,
	next: nextLinks.find((link) => link.tag === tag)?.post,
}));
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description} image={cover}>
	<article>
		<header class="post-header post-body">
			<h1>{title}</h1>
			<p class="lead">{description}</p>
			<div class="meta mono">
				<span class="node"></span>
				<FormattedDate date={date} />
				{updated && (
					<span>
						updated <FormattedDate date={updated} />
					</span>
				)}
				{member && (
					<a class="author" href={url(`/team/${member.id}/`)}>
						{member.name}
					</a>
				)}
				{tags.map((tag) => <a class="pill" href={url(`/posts/?tag=${encodeURIComponent(tag)}`)}>{tag}</a>)}
			</div>
			{cover && <Image class="wide cover" src={cover} alt={coverAlt} width={1600} priority />}
		</header>

		<div class="post-body">
			{time && <TimeReport time={time} />}
			<slot />
		</div>

		{rows.length > 0 && (
			<nav class="post-body pager" aria-label="More posts in this storyline">
				{rows.map(({ tag, prev, next }) => (
					<div class="pager-row">
						{prev && (
							<a class="pill" href={url(`/posts/${prev.id}/`)} rel="prev" title={prev.data.title}>
								<svg class="back" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" /></svg>
								Previous {tag} article
							</a>
						)}
						{next && (
							<a class="pill next" href={url(`/posts/${next.id}/`)} rel="next" title={next.data.title}>
								Next {tag} article
								<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" /></svg>
							</a>
						)}
					</div>
				))}
			</nav>
		)}
	</article>
</BaseLayout>

<style>
	.post-header {
		margin-block: 4rem 3rem;
	}
	.post-header h1 {
		margin-bottom: 1.5rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-line);
	}
	.author {
		color: var(--color-text);
		text-decoration: none;
	}
	.author:hover {
		text-decoration: underline;
	}
	.pager {
		display: grid;
		gap: 0.75rem;
		margin-top: 4rem;
	}
	.pager-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.pager .pill {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}
	.pager .next {
		margin-left: auto;
	}
	.pager svg {
		width: 0.85em;
		height: 0.85em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
	}
	.pager .back {
		transform: scaleX(-1);
	}
	.cover {
		margin-top: 3rem;
		border-radius: var(--radius-leaf);
	}
</style>
