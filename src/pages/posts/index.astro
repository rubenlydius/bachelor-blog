---
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
// Every tag used in a post, alphabetically
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title={`Posts · ${SITE_TITLE}`} description="All posts documenting the project.">
	<div class="container">
		<header class="page-header">
			<h1>Posts</h1>
			<p class="lead">Weekly updates on research, process and progress.</p>
		</header>

		<div class="toolbar">
			{tags.length > 0 && (
			<nav class="filters mono" aria-label="Filter posts by tag">
				<button type="button" class="pill" data-filter="" aria-pressed="true">all</button>
				{tags.map((tag) => (
					<button type="button" class="pill" data-filter={tag} aria-pressed="false">
						{tag}
					</button>
				))}
			</nav>
			)}
			<button type="button" class="pill sort mono" aria-label="Sort order">
				<span class="sort-label">newest first</span>
				<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2v8M2.5 6.5 6 10l3.5-3.5" /></svg>
			</button>
		</div>

		<PostList posts={posts} />
	</div>
</BaseLayout>

<script>
	// Filters the post list in the browser; the active tag is kept in the URL (?tag=ux) so it can be shared.
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const items = document.querySelectorAll<HTMLElement>('.post-list > li');

	function apply(tag: string) {
		for (const button of buttons) {
			button.setAttribute('aria-pressed', String(button.dataset.filter === tag));
		}
		for (const item of items) {
			item.hidden = tag !== '' && !(item.dataset.tags ?? '').split('|').includes(tag);
		}
		const url = new URL(location.href);
		if (tag) url.searchParams.set('tag', tag);
		else url.searchParams.delete('tag');
		history.replaceState(null, '', url);
	}

	for (const button of buttons) {
		button.addEventListener('click', () => apply(button.dataset.filter ?? ''));
	}

	// Sort order: posts come newest first from the server, reversing the list flips it.
	// Kept in the URL as ?sort=oldest.
	const sortButton = document.querySelector<HTMLButtonElement>('.sort')!;
	const list = document.querySelector<HTMLElement>('.post-list');
	let oldestFirst = false;

	function setSort(oldest: boolean) {
		if (oldest !== oldestFirst && list) {
			list.append(...[...list.children].reverse());
		}
		oldestFirst = oldest;
		sortButton.classList.toggle('oldest', oldest);
		sortButton.querySelector('.sort-label')!.textContent = oldest ? 'oldest first' : 'newest first';
		const url = new URL(location.href);
		if (oldest) url.searchParams.set('sort', 'oldest');
		else url.searchParams.delete('sort');
		history.replaceState(null, '', url);
	}

	sortButton.addEventListener('click', () => setSort(!oldestFirst));
	if (new URLSearchParams(location.search).get('sort') === 'oldest') setSort(true);

	const initial = new URLSearchParams(location.search).get('tag') ?? '';
	if ([...buttons].some((button) => button.dataset.filter === initial)) apply(initial);
</script>

<style>
	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 3rem;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	/* Always on the right, also when the filters are missing */
	.sort {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		margin-left: auto;
		border-color: var(--color-text);
	}
	.sort svg {
		width: 0.85em;
		height: 0.85em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
		transition: transform 0.2s;
	}
	.sort.oldest svg {
		transform: scaleY(-1);
	}
	.sort:hover {
		background: var(--color-text);
		color: var(--color-accent);
	}
	/* Same treatment as the header nav: outline marks the active filter */
	button {
		border-color: transparent;
		background: none;
		color: var(--color-text);
		font-size: var(--text-small);
		cursor: pointer;
	}
	button:hover {
		border-color: var(--color-border);
	}
	button[aria-pressed='true'] {
		border-color: var(--color-text);
	}
</style>
