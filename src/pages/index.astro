---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="container">
		<header class="page-header">
			<h1>{SITE_TITLE}</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
		</header>

		<section class="split">
			<h2>About this blog</h2>
			<div>
				<p>
					[Placeholder] What this blog is: a log of our bachelor project where we document
					research, decisions, prototypes and lessons learned along the way.
				</p>
			</div>
		</section>

		<section class="split">
			<h2>The goal</h2>
			<div>
				<p>
					[Placeholder] The problem we are tackling, who it is for, and what we want to deliver
					by the end of the semester.
				</p>
			</div>
		</section>

		{latest.length > 0 && (
			<section class="latest">
				<div class="latest-header">
					<h2>Latest posts</h2>
					<a href="/posts/">All posts →</a>
				</div>
				<PostList posts={latest} />
			</section>
		)}
	</div>
</BaseLayout>

<style>
	.split {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 2rem;
		padding-block: 2.5rem;
		border-top: 1px solid var(--color-border);
	}
	.split h2 {
		margin: 0;
		font-size: 1.375rem;
	}
	.split p:last-child {
		margin-bottom: 0;
	}
	.latest {
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-border);
	}
	.latest-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 2rem;
	}
	.latest-header h2 {
		margin: 0;
		font-size: 1.375rem;
	}
	@media (max-width: 720px) {
		.split {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
