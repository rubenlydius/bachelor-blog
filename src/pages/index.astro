---
import PostList from '../components/PostList.astro';
import Timeline from '../components/Timeline.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { timeline } from '../data/timeline';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { url } from '../lib/url';

const latest = (await getPosts()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="container">
		<header class="page-header">
			<h1>{SITE_TITLE}</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
		</header>

		<section class="section split">
			<h2 class="section-title"><span class="node"></span>About this blog</h2>
			<div>
				<p>
					We're Elitsa, Miriam and Ruben, working on our bachelor project <strong>Breathe Back to Light </strong>
					for Transfo Intiem. Here we keep track of our process: what we're working on, how we tackle
					it, and what we learn along the way.
				</p>
			</div>
		</section>

		<section class="section">
			<h2 class="section-title"><span class="node"></span>Timeline</h2>
			<Timeline events={timeline} />
		</section>

		{latest.length > 0 && (
			<section class="section">
				<div class="latest-header">
					<h2 class="section-title"><span class="node"></span>Latest posts</h2>
					<a class="pill all-posts" href={url('/posts/')}>
						All posts
						<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" /></svg>
					</a>
				</div>
				<PostList posts={latest} />
			</section>
		)}
	</div>
</BaseLayout>

<style>
	.split {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 2rem;
		align-items: start;
	}
	/* Same line height as the text's first line, so the title lines up with it */
	.split .section-title {
		line-height: calc(var(--text-base) * var(--leading));
	}
	.split p:last-child {
		margin-bottom: 0;
	}
	.latest-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.5rem;
	}
	.all-posts {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}
	.all-posts svg {
		width: 0.85em;
		height: 0.85em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
	}
	@media (max-width: 720px) {
		.split {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
