---
import PostList from '../components/PostList.astro';
import Timeline from '../components/Timeline.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { timeline } from '../data/timeline';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="container">
		<header class="page-header">
			<h1>{SITE_TITLE}</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
		</header>

		<section class="section split">
			<h2 class="section-title"><span class="node"></span>About this blog</h2>
			<div>
				<p>
					[Placeholder] What this blog is: a log of our bachelor project where we document
					research, decisions, prototypes and lessons learned along the way.
				</p>
			</div>
		</section>

		<section class="section">
			<h2 class="section-title"><span class="node"></span>Timeline</h2>
			<Timeline events={timeline} />
		</section>

		{latest.length > 0 && (
			<section class="section">
				<div class="latest-header">
					<h2 class="section-title"><span class="node"></span>Latest posts</h2>
					<a class="pill" href="/posts/">All posts →</a>
				</div>
				<PostList posts={latest} />
			</section>
		)}
	</div>
</BaseLayout>

<style>
	.split {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 2rem;
	}
	.split p:last-child {
		margin-bottom: 0;
	}
	.latest-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.5rem;
	}
	@media (max-width: 720px) {
		.split {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
